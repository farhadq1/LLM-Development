async function fetchDataProductDatasetRelations(): Promise<Relation[]> {
  const all: Relation[] = [];
  let offset = 0;
  const limit = 500;

  while (true) {
    const res = await fetch(
      `/rest/2.0/relations?sourceType=DataProduct&targetType=Dataset&limit=${limit}&offset=${offset}`
    );

    if (!res.ok) throw new Error("Relations fetch failed");

    const data = await res.json();
    all.push(...data.results);

    if (data.results.length < limit) break;
    offset += limit;
  }

  return all;
}









export async function searchDataProductsWithDatasets(
  query: string
): Promise<Asset[]> {
  const [dataProducts, relations] = await Promise.all([
    searchDataProducts(query),
    fetchDataProductDatasetRelations()
  ]);

  const dataProductsWithDatasets = new Set(
    relations
      .filter(r =>
        r.type.name === "contains" &&
        r.source.type.name === "Data Product"
      )
      .map(r => r.source.id)
  );

  return dataProducts.filter(dp =>
    dataProductsWithDatasets.has(dp.id)
  );
}



